{
  "description": {
    "drug": "linezolid",
    "route": [
      {
        "route": "PO",
        "compartment": 1
      }
    ],
    "name": "linezolid_plt",
    "compartment": {
      "number": 2,
      "central": 1,
      "peripheral": null,
      "outputs": [
        {
          "name": "central",
          "equation": 1
        },
        {
          "name": "platelets",
          "equation": 2,
          "pd": {
            "label": "Platelets",
            "unit": "10^9/L"
          }
        }
      ]
    },
    "version": 1,
    "description": "Example joint PK/PD model (dev): oral one-compartment linezolid and the Friberg semi-mechanistic myelosuppression model of platelets (proliferating pool, three transit compartments, circulating pool, feedback gamma). Seven states: the longest chain of the examples. Synthetic support points drawn around typical values from the literature, not for clinical use. References: Friberg LE et al., J Clin Oncol 2002;20:4713-4721; Sasaki T et al., Antimicrob Agents Chemother 2011;55:1867-1873.",
    "reference": "Friberg, J Clin Oncol, 2002",
    "reference_url": "",
    "covariates": {
      "number": 1,
      "names": [
        "weight"
      ],
      "label": [
        "Weight"
      ],
      "units": [
        "kg"
      ],
      "types": [
        "numeric"
      ],
      "value": {
        "weight": [
          {
            "min": 30.0,
            "max": 200.0,
            "default": 70.0
          }
        ]
      },
      "description": {
        "weight": "Patient weight in kilograms"
      }
    },
    "native": true,
    "default_model": true,
    "pd_parameters": [
      "circ0",
      "mtt",
      "gam",
      "slope"
    ]
  },
  "model": {
    "primary": {
      "ka": {
        "type": "ab",
        "min": 0.5,
        "max": 6
      },
      "cl0": {
        "type": "ab",
        "min": 2,
        "max": 15
      },
      "v0": {
        "type": "ab",
        "min": 20,
        "max": 80
      },
      "circ0": {
        "type": "ab",
        "min": 120,
        "max": 400
      },
      "mtt": {
        "type": "ab",
        "min": 60,
        "max": 300
      },
      "gam": {
        "type": "ab",
        "min": 0.05,
        "max": 0.5
      },
      "slope": {
        "type": "ab",
        "min": 0.002,
        "max": 0.03
      }
    },
    "covariates": {
      "weight": {
        "interp": "linear"
      }
    },
    "secondary": {
      "cl": "cl = cl0 * (weight / 70)^0.75",
      "v": "v = v0 * weight / 70",
      "ktr": "ktr = 4 / mtt"
    },
    "initial_conditions": {
      "x3": "X[3] = circ0",
      "x4": "X[4] = circ0",
      "x5": "X[5] = circ0",
      "x6": "X[6] = circ0",
      "x7": "X[7] = circ0"
    },
    "fa": null,
    "lag": null,
    "equation": {
      "dx1": "dx[1] = B[1] - ka * X[1]",
      "dx2": "dx[2] = ka * X[1] - cl / v * X[2]",
      "dx3": "dx[3] = ktr * X[3] * (1 - slope * X[2] / v) * (circ0 / X[7])^gam - ktr * X[3]",
      "dx4": "dx[4] = ktr * (X[3] - X[4])",
      "dx5": "dx[5] = ktr * (X[4] - X[5])",
      "dx6": "dx[6] = ktr * (X[5] - X[6])",
      "dx7": "dx[7] = ktr * X[6] - ktr * X[7]"
    },
    "out": {
      "y1": "Y[1] = X[2] / v",
      "y2": "Y[2] = X[7]"
    },
    "error": {
      "type": "proportional",
      "initial_value": 1.0,
      "coefficient": [
        {
          "c0": 0.1,
          "c1": 0.1,
          "c2": 0.0,
          "c3": 0.0
        },
        {
          "c0": 15.0,
          "c1": 0.0,
          "c2": 0.0,
          "c3": 0.0,
          "type": "additive",
          "initial_value": 1.0
        }
      ]
    }
  },
