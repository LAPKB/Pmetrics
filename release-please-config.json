{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "packages": {
        ".": {
            "release-type": "simple",
            "package-name": "Pmetrics",
            "changelog-path": "CHANGELOG.md",
            "extra-files": [
                {
                    "type": "generic",
                    "path": "DESCRIPTION"
                }
            ],
            "include-component-in-tag": false,
            "include-v-in-tag": true,
            "changelog-sections": [
                {
                    "type": "feat",
                    "section": "Features"
                },
                {
                    "type": "fix",
                    "section": "Bug Fixes"
                },
                {
                    "type": "perf",
                    "section": "Performance"
                },
                {
                    "type": "deps",
                    "section": "Dependencies"
                },
                {
                    "type": "chore",
                    "section": "Maintenance"
                },
                {
                    "type": "docs",
                    "section": "Documentation"
                },
                {
                    "type": "refactor",
                    "section": "Refactoring"
                },
                {
                    "type": "ci",
                    "section": "Continuous Integration",
                    "hidden": true
                },
                {
                    "type": "test",
                    "section": "Tests",
                    "hidden": true
                }
            ]
        }
    }
}